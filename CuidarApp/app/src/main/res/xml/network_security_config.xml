<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bloqueia tráfego de rede - app funciona 100% offline -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
